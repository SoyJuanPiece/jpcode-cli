#!/usr/bin/env bash
# Qwen Code apuntando al gateway de opencode-chat (los 225 proveedores + Zen).
#
# Es el hermano de `claude`: mismo truco, otro agente. Levanta el proxy si no
# está, le pasa la clave por entorno y arranca Qwen Code de verdad.
#
#   OPENCODE_PROXY_PORT   puerto del proxy (por defecto 8096)
#   OPENCODE_CHAT_DIR     carpeta con server.mjs y .api-key
#   QWEN_REAL_BIN         binario real de Qwen Code (si la autodetección falla)
#
# La config que apunta Qwen Code al gateway vive en ~/.qwen/settings.json y la
# instala install-claude.sh (modelProviders + security.auth.selectedType).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/server.mjs" ]; then
  DEFAULT_CHAT_DIR="$SCRIPT_DIR"
else
  DEFAULT_CHAT_DIR="${HOME}/studio/opencode-chat"
fi
CHAT_DIR="${OPENCODE_CHAT_DIR:-$DEFAULT_CHAT_DIR}"

resolver_real() {
  local c
  for c in \
    "${QWEN_REAL_BIN:-}" \
    "${HOME}/.global_modules/bin/qwen" \
    "${HOME}/.npm-global/bin/qwen" \
    "/usr/local/bin/qwen" \
    "/usr/lib/node_modules/@qwen-code/qwen-code/cli-entry.js"; do
    [ -n "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
REAL="$(resolver_real)" || {
  echo "⚠️  No encuentro el binario real de Qwen Code. Instálalo con:" >&2
  echo "    npm i -g @qwen-code/qwen-code" >&2
  exit 127
}

KEY_FILE="$CHAT_DIR/.api-key"
ZEN_FILE="$CHAT_DIR/.zen-key"
PORT="${OPENCODE_PROXY_PORT:-8096}"
SESSION="${OPENCODE_PROXY_SESSION:-claude-proxy}"
HEALTH="http://127.0.0.1:$PORT/api/status"

vivo() { curl -sf -m 2 "$HEALTH" >/dev/null 2>&1; }

if ! vivo; then
  if command -v tmux >/dev/null 2>&1 && [ -f "$CHAT_DIR/server.mjs" ]; then
    ZEN=""
    [ -s "$ZEN_FILE" ] && ZEN="$(cat "$ZEN_FILE")"
    echo "→ levantando el gateway en el puerto $PORT…" >&2
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    if [ -n "$ZEN" ]; then
      tmux new-session -d -s "$SESSION" -c "$CHAT_DIR" \
        "HOST=127.0.0.1 OPENCODE_API_KEY='$ZEN' node server.mjs $PORT > .run-claude.log 2>&1"
    else
      tmux new-session -d -s "$SESSION" -c "$CHAT_DIR" \
        "HOST=127.0.0.1 node server.mjs $PORT > .run-claude.log 2>&1"
    fi
    for _ in $(seq 1 60); do
      vivo && break
      sleep 0.25
    done
  fi
fi

if ! vivo; then
  echo "⚠️  El gateway no responde en http://127.0.0.1:$PORT" >&2
  echo "    Arráncalo a mano: cd $CHAT_DIR && node server.mjs $PORT" >&2
fi

# La lista de /model se rellena con lo que el gateway tenga usable AHORA (gratis
# de Zen + proveedores conectados), etiquetado «Modelo · Proveedor» como en
# OpenCode. Así, al conectar algo con /connect, aparece sin tocar nada más.
#   OPENCODE_SYNC_MODELS=0   desactiva este refresco
if [ -f "$CHAT_DIR/sync-qwen-models.mjs" ] && [ "${OPENCODE_SYNC_MODELS:-1}" != "0" ] && vivo; then
  QWEN_SETTINGS="${QWEN_HOME:-$HOME/.qwen}/settings.json" \
    node "$CHAT_DIR/sync-qwen-models.mjs" >/dev/null 2>&1 || true
fi

# Qwen Code no persiste credenciales: las lee de process.env[envKey], y en
# ~/.qwen/settings.json cada modelo declara envKey=OPENCODE_GATEWAY_KEY.
if [ -s "$KEY_FILE" ]; then
  export OPENCODE_GATEWAY_KEY="$(cat "$KEY_FILE")"
fi

exec "$REAL" "$@"
