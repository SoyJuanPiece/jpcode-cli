# Dependencias (jpcode no tiene, pero por si acaso)
node_modules/
package-lock.json
bun.lockb

# Artefactos de ejecución: imágenes que llegan del puente, logs, temporales
tmp/
*.log

# Sistema
.DS_Store
Thumbs.db

# Artefactos de release (los genera release.sh)
dist/

# El motor vendorizado (lo genera vendor-engine.sh, ~95 MB): es un artefacto de
# construcción, no fuente. Se reproduce con `bash vendor-engine.sh`.
engine/

# Lo que el gateway (gateway/) genera al arrancar: NUNCA se sube.
# .api-key se autogenera solo la primera vez; .zen-key es TU clave de Zen.
gateway/.api-key
gateway/.zen-key
gateway/.cache/
gateway/.bin/
gateway/*.log

# Clave compartida del gateway local: se genera en cada instalación
/.api-key
